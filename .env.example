# Copy this file to .env and fill in what you need. Never commit .env.

# --- ElevenLabs voiceover (leave empty to use the free Windows offline voice) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=P1bg08DkjqiVEzOn76yG
# Optional, default eleven_multilingual_v2
ELEVENLABS_MODEL_ID=

# --- Claude: converts plain-English scripts (e.g. Loom scripts) into steps ---
# console.anthropic.com > API Keys. Without it, scripts must be pasted in the step format.
ANTHROPIC_API_KEY=
# CONVERT_MODEL=claude-opus-5-5

# --- Windows offline voice (fallback) ---
# Optional: an installed voice name, e.g. "Microsoft Zira Desktop". Empty = system default.
WINDOWS_TTS_VOICE=
# Optional: speaking rate from -10 (slow) to 10 (fast). Default 0.
WINDOWS_TTS_RATE=0

# --- Tools (only if auto-detection fails) ---
# OPENSCREEN_EXE=C:\Users\you\AppData\Local\Microsoft\WindowsApps\openscreen.exe
# FFMPEG=C:\path\to\ffmpeg.exe
# BROWSER_CHANNEL=chrome        # chrome | msedge

# --- Pacing (milliseconds) ---
# LEAD_IN_MS=1500       # still frames before the first step
# STEP_GAP_MS=500       # silence after each narration line
# ACTION_HOLD_MS=1000   # minimum time a result stays on screen
# TAIL_MS=2000          # still frames after the last step
# SELECTOR_TIMEOUT_MS=10000

# --- Web interface ---
# UI_PORT=4400
# Password for the web interface's lock page. Leave empty and the interface is NOT locked.
UI_PASSWORD=
# How long a sign-in lasts, in days (default 7).
# UI_SESSION_DAYS=7

# --- Share links ---
# The public watch pages run on their own port; only this port goes through the tunnel.
# SHARE_PORT=4401
# Permanent address (Cloudflare account + a domain on Cloudflare). Without these, a free
# random trycloudflare.com address is used, which changes every time the UI restarts.
# SHARE_TUNNEL_TOKEN=
# SHARE_BASE_URL=https://videos.yourdomain.com
# SHARE_TUNNEL_PROTOCOL=http2   # or quic
# CLOUDFLARED=C:\Program Files (x86)\cloudflared\cloudflared.exe

# --- Captions ---
# CAPTIONS_LANGUAGE=en
# Narration tone (0 to 1). Defaults: enthusiastic, confident, friendly.
ELEVENLABS_STABILITY=0.35
ELEVENLABS_SIMILARITY=0.8
ELEVENLABS_STYLE=0.45

# Video background image (JPEG or PNG, 1920x1080 is best). Default: assets/background.jpg
VIDEO_BACKGROUND=
